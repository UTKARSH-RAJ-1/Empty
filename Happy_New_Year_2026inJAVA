import java.time.LocalDateTime;
import java.util.Random;
import java.util.concurrent.TimeUnit;

public class AdvancedNewYear {

    // ANSI Color Array for variety
    private static final String[] COLORS = {
        "\u001B[31m", "\u001B[32m", "\u001B[33m", 
        "\u001B[34m", "\u001B[35m", "\u001B[36m"
    };
    private static final String RESET = "\u001B[0m";

    public static void main(String[] args) {
        checkDateAndCelebrate();
    }

    private static void checkDateAndCelebrate() {
        int year = LocalDateTime.now().getYear();
        System.out.println("Initializing Celebration Protocol for " + year + "...");

        try {
            // Launch multiple firework threads
            for (int i = 0; i < 3; i++) {
                new FireworkThread("Rocket " + (i + 1)).start();
                Thread.sleep(1200); 
            }
            
            // Final Grand Display
            Thread.sleep(1000);
            printBanner(year);
            
        } catch (InterruptedException e) {
            Thread.currentThread().interrupt();
        }
    }

    private static void printBanner(int year) {
        String msg = " HAPPY NEW YEAR " + year + " ";
        String border = "=".repeat(msg.length() + 4);
        
        System.out.println("\n" + COLORS[1] + border);
        System.out.println("| " + COLORS[3] + msg + COLORS[1] + " |");
        System.out.println(border + RESET);
        
        System.out.println("\n" + COLORS[2] + "  _  _   __   ____  ____  _  _ ");
        System.out.println(" ( \\/ ) (  ) (  _ \\(  _ \\( \\/ )");
        System.out.println("  \\  /   )(   )   / )   / \\  / ");
        System.out.println("  (__)  (__) (_)\\_)(_)\\_) (__) " + RESET);
    }
}

class FireworkThread extends Thread {
    private final String name;
    private final Random rand = new Random();

    public FireworkThread(String name) { this.name = name; }

    @Override
    public void run() {
        try {
            // 1. Launch Phase
            for (int i = 0; i < 5; i++) {
                System.out.println(" ".repeat(10) + "  ^  ");
                TimeUnit.MILLISECONDS.sleep(200);
            }

            // 2. Explosion Phase (Randomized Color)
            String color = "\u001B[3" + (rand.nextInt(6) + 1) + "m";
            System.out.println(color + "      _.-^^---....,,--_");
            System.out.println("  _--                  --_");
            System.out.println(" <                        >");
            System.out.println("  \\._                   _./");
            System.out.println("     ```--. . , ; .--'''" + "\u001B[0m");
            System.out.println("           | |   [" + name + " POP!]");
            
        } catch (InterruptedException e) {
            System.out.println("Firework " + name + " duded out!");
        }
    }
}
